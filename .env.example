# ===== Crazy Snooker App — ตัวอย่าง env (คัดลอกเป็น .env หรือตั้งบน Render) =====
# อย่า commit ไฟล์ .env จริง

# --- ฐานข้อมูล (Aiven MySQL) ---
DATABASE_URL=mysql://avnadmin:password@your-service.aivencloud.com:12345/defaultdb
DATABASE_SSL=true
# DATABASE_CA=-----BEGIN CERTIFICATE----- ... (ถ้าใส่จะ verify cert แบบเข้มงวด)

# --- เซิร์ฟเวอร์ ---
PORT=3000
JWT_SECRET=change-me-long-random-string
ADMIN_FEEDBACK_KEY=change-me-admin-key

# --- PromptPay (รอเลขจริงจากร้าน) ---
# PROMPTPAY_RECIPIENT=0812345678

# --- LINE OA ---
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_NOTIFY_TO=

# --- อีเมลใบเสร็จ (Resend — ทีหลัง) ---
# RESEND_API_KEY=
# RECEIPT_EMAIL_FROM=receipts@yourdomain.com

# --- Encrypted secrets store (ทางเลือก — ถ้าไม่ใช้ ให้ตั้ง env ตรงๆ) ---
# SECRETS_KEY=<hex 64 ตัวจาก scripts/manage-secrets.mjs generate-key>
